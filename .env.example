# Service BL (src/bl-api) — lecture de HFSQL. Copier en .env à la racine du projet.

# Copie locale HFSQL Classic (développement)
HFSQL_CONN=DSN=allaa;RepFic=C:\Users\Admin\Documents\project\DOSSIER\D001\

# HFSQL Client/Serveur (production, réseau de l'entreprise)
# HFSQL_CONN=DSN=commercial

PORT=3100
# Par défaut le service reste local. Pour un service partagé sur le LAN, définir
# explicitement HOST=0.0.0.0 et protéger le port par le pare-feu / VPN.
HOST=127.0.0.1
BL_TYPE=23
ARTICLE_CACHE_TTL_MS=60000

# Délais (ms) : ouverture de la connexion ODBC / une requête
# HFSQL_CONNECT_TIMEOUT_MS=6000
# HFSQL_QUERY_TIMEOUT_MS=10000

# Optionnel : autoriser un frontend navigateur séparé à appeler le service
# CORS_ORIGIN=http://localhost:5173
