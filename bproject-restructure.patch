diff --git a/src/bl-api/bl-service.test.ts b/src/bl-api/bl-service.test.ts
new file mode 100644
index 0000000..df1fc25
--- /dev/null
+++ b/src/bl-api/bl-service.test.ts
@@ -0,0 +1,120 @@
+import { describe, expect, it } from 'vitest'
+import { parseBlInput } from '@shared/domain/bl-number'
+import { createBlService } from './bl-service'
+import { createSchema } from './schema'
+import { isAmbiguous, type BlResult } from './types'
+import { blHandler, fakeDb } from './fake-db.testutil'
+
+const config = { blType: 23, articleCacheTtlMs: 60_000 }
+
+function setup(overrides?: Parameters<typeof blHandler>[0], now = () => 1_000_000) {
+  const db = fakeDb(blHandler(overrides))
+  const service = createBlService(db, createSchema(db), config, now)
+  return { db, service }
+}
+
+async function bl(service: ReturnType<typeof setup>['service'], input: string): Promise<BlResult> {
+  const result = await service.getBl(parseBlInput(input))
+  if (!result || isAmbiguous(result)) throw new Error('BL attendu')
+  return result
+}
+
+describe('createBlService.getBl', () => {
+  it('résout BL26-05255 : client, lignes et 2 000 kg (quintaux)', async () => {
+    const { service } = setup()
+    const { bl: header, lines } = await bl(service, 'BL26-05255')
+
+    expect(header.reference).toBe('BL26-05255')
+    expect(header.date).toBe('2026-07-01')
+    expect(header.client?.name).toBe('HANGAR AIN NOUISSY')
+    expect(header.lineCount).toBe(3)
+    expect(header.totalWeightKg).toBe(2000)
+    expect(header.weightComplete).toBe(true)
+    expect(lines.map((l) => [l.code, l.weightKg, l.weightSource])).toEqual([
+      ['VIG 1L', 200, 'quintal'],
+      ['INT A+', 600, 'quintal'],
+      ['INT A+', 1200, 'quintal']
+    ])
+  })
+
+  it("renvoie null quand aucun BL ne correspond", async () => {
+    const { service } = setup()
+    expect(await service.getBl(parseBlInput('BL20-00001'))).toBeNull()
+  })
+
+  it('signale un numéro seul présent sur plusieurs années', async () => {
+    const { service } = setup()
+    const result = await service.getBl(parseBlInput('5255'))
+
+    expect(result && isAmbiguous(result)).toBe(true)
+    if (!result || !isAmbiguous(result)) return
+    expect(result.candidates.map((c) => c.reference)).toEqual(['BL26-05255', 'BL25-05255'])
+    expect(result.candidates[0]?.client?.name).toBe('HANGAR AIN NOUISSY')
+  })
+
+  it("lève l'ambiguïté avec l'année", async () => {
+    const { service } = setup()
+    const result = await service.getBl(parseBlInput('5255', '2025'))
+    expect(result && !isAmbiguous(result) && result.bl.reference).toBe('BL25-05255')
+  })
+
+  it("n'annonce aucun total quand une ligne n'a ni poids ni quantité", async () => {
+    const { service } = setup({
+      lines: [
+        { lineId: 1, articleId: 230, quantity: 2, weight: 0, unitWeight: 0 },
+        { lineId: 2, articleId: 231, quantity: 0, weight: 0, unitWeight: 0 }
+      ]
+    })
+    const { bl: header } = await bl(service, 'BL26-05255')
+
+    expect(header.weightComplete).toBe(false)
+    expect(header.totalWeightKg).toBeNull()
+    expect(header.knownWeightKg).toBe(200)
+    expect(header.unknownWeightLines).toBe(1)
+  })
+
+  it("préfère le poids de l'article quand il existe", async () => {
+    const { service } = setup({
+      articles: [{ id: 230, code: 'SAC', name: 'Sac 25 kg', weight: 25 }],
+      lines: [{ lineId: 1, articleId: 230, quantity: 4, weight: 0, unitWeight: 0 }]
+    })
+    const { lines } = await bl(service, 'BL26-05255')
+    expect(lines[0]).toMatchObject({ weightKg: 100, weightSource: 'article' })
+  })
+
+  it("retombe sur le libellé de la ligne quand l'article est inconnu", async () => {
+    const { service } = setup({
+      lines: [{ lineId: 1, articleId: 999, lineLabel: 'Ligne libre', quantity: 1 }]
+    })
+    const { lines } = await bl(service, 'BL26-05255')
+    expect(lines[0]).toMatchObject({ code: null, name: 'Ligne libre' })
+  })
+})
+
+describe('cache des articles', () => {
+  const articleQueries = (db: ReturnType<typeof setup>['db']) =>
+    db.queries.filter((sql) => /FROM Articles/.test(sql)).length
+
+  it('ne recharge pas la table à chaque BL', async () => {
+    const { db, service } = setup()
+    await bl(service, 'BL26-05255')
+    await bl(service, 'BL26-05255')
+    expect(articleQueries(db)).toBe(1)
+  })
+
+  it('un article supprimé ne relance pas un rechargement à chaque recherche', async () => {
+    let time = 1_000_000
+    const { db, service } = setup(
+      { lines: [{ lineId: 1, articleId: 999, quantity: 1 }] },
+      () => time
+    )
+
+    await bl(service, 'BL26-05255') // chargement + rechargement forcé (article 999 absent)
+    await bl(service, 'BL26-05255') // dans la fenêtre : aucun rechargement
+    expect(articleQueries(db)).toBe(2)
+
+    time += 11_000
+    await bl(service, 'BL26-05255') // fenêtre écoulée : un nouveau rechargement forcé est permis
+    expect(articleQueries(db)).toBe(3)
+  })
+})
diff --git a/src/bl-api/bl-service.ts b/src/bl-api/bl-service.ts
new file mode 100644
index 0000000..ccfee85
--- /dev/null
+++ b/src/bl-api/bl-service.ts
@@ -0,0 +1,381 @@
+/**
+ * Lecture d'un BL dans HFSQL : en-tête (Mouvement), client (Tiers), lignes
+ * (Ligne_MT) et articles. Lecture seule : seuls des SELECT sont émis.
+ *
+ * Les requêtes SQL sont celles validées sur la base réelle ; ne les modifiez
+ * qu'avec un test contre HFSQL (`npm run bl:probe`).
+ */
+import { parseBlInput, type ParsedBlNumber } from '@shared/domain/bl-number'
+import { resolveLineWeight, round3, summarizeWeights } from '@shared/domain/bl-weight'
+import type { BlApiConfig } from './config'
+import type { Db, Row } from './db'
+import { getFullDetails } from './full-details'
+import type { Schema } from './schema'
+import { int, quoteString } from './sql'
+import type { BlAmbiguous, BlCandidate, BlClientDto, BlLineDto, BlResult } from './types'
+
+const HEADER_SELECT = `
+  SELECT IDMouvement AS id,
+         Reference AS reference,
+         Annee AS docYear,
+         Numero AS docNumber,
+         Date AS docDate,
+         Heure AS docTime,
+         Date_Livraison AS deliveryDate,
+         Statut AS status,
+         IdTiers AS clientId,
+         HT AS totalHt,
+         TTC AS totalTtc
+    FROM Mouvement`
+
+/** Un article absent du cache ne relance pas le rechargement plus d'une fois par intervalle. */
+const MIN_FORCED_RELOAD_MS = 10_000
+const MAX_CANDIDATES = 20
+
+interface ArticleInfo {
+  code: string | null
+  name: string | null
+  barcode: string | null
+  familyId: number | null
+  subFamilyId: number | null
+  unitId: number | null
+  classification: number | null
+  category: number | null
+  weight: number | null
+}
+
+/** Le pilote peut renvoyer l'alias tel quel, en majuscules ou en minuscules. */
+function read(row: Row | undefined, key: string): unknown {
+  if (!row) return undefined
+  if (key in row) return row[key]
+  if (key.toUpperCase() in row) return row[key.toUpperCase()]
+  if (key.toLowerCase() in row) return row[key.toLowerCase()]
+  return undefined
+}
+
+function clean(value: unknown): string | null {
+  if (value === null || value === undefined) return null
+  const text = String(value).trim()
+  return text === '' ? null : text
+}
+
+function toNumber(value: unknown): number | null {
+  if (value === null || value === undefined || value === '') return null
+  const number = typeof value === 'bigint' ? Number(value) : Number(value)
+  return Number.isFinite(number) ? number : null
+}
+
+function round2(value: number): number {
+  return Math.round((value + Number.EPSILON) * 100) / 100
+}
+
+export function formatDate(value: unknown): string | null {
+  if (value === null || value === undefined || value === '') return null
+  if (value instanceof Date && !Number.isNaN(value.getTime())) {
+    return value.toISOString().slice(0, 10)
+  }
+  const text = String(value).trim()
+  if (/^\d{8}$/.test(text)) return `${text.slice(0, 4)}-${text.slice(4, 6)}-${text.slice(6, 8)}`
+  if (/^\d{4}-\d{2}-\d{2}/.test(text)) return text.slice(0, 10)
+  return null
+}
+
+interface Header {
+  id: number | null
+  reference: string | null
+  year: number | null
+  number: number | null
+  date: string | null
+  time: string | null
+  deliveryDate: string | null
+  status: number | null
+  clientId: number | null
+  totalHt: number | null
+  totalTtc: number | null
+}
+
+function mapHeader(row: Row): Header {
+  return {
+    id: toNumber(read(row, 'id')),
+    reference: clean(read(row, 'reference')),
+    year: toNumber(read(row, 'docYear')),
+    number: toNumber(read(row, 'docNumber')),
+    date: formatDate(read(row, 'docDate')),
+    time: clean(read(row, 'docTime')),
+    deliveryDate: formatDate(read(row, 'deliveryDate')),
+    status: toNumber(read(row, 'status')),
+    clientId: toNumber(read(row, 'clientId')),
+    totalHt: toNumber(read(row, 'totalHt')),
+    totalTtc: toNumber(read(row, 'totalTtc'))
+  }
+}
+
+export interface GetBlOptions {
+  full?: boolean
+}
+
+export interface BlService {
+  getBl(parsed: ParsedBlNumber, options?: GetBlOptions): Promise<BlResult | BlAmbiguous | null>
+  getClient(clientId: number | null): Promise<BlClientDto | null>
+}
+
+export function createBlService(
+  db: Db,
+  schema: Schema,
+  config: Pick<BlApiConfig, 'blType' | 'articleCacheTtlMs'>,
+  now: () => number = Date.now
+): BlService {
+  let articleCache = { loadedAt: 0, forcedAt: 0, map: new Map<number, ArticleInfo>() }
+
+  async function loadArticles(force = false): Promise<Map<number, ArticleInfo>> {
+    const age = now() - articleCache.loadedAt
+    const fresh = articleCache.map.size > 0 && age < config.articleCacheTtlMs
+    if (fresh && !force) return articleCache.map
+    // Un rechargement forcé trop rapproché est ignoré (article supprimé dans HFSQL).
+    if (force && now() - articleCache.forcedAt < MIN_FORCED_RELOAD_MS && articleCache.map.size > 0) {
+      return articleCache.map
+    }
+
+    const rows = await db.query(
+      `SELECT IDArticle AS id,
+              Reference AS code,
+              Libelle AS name,
+              Code_Barres AS barcode,
+              Famille AS familyId,
+              Sous_Famille AS subFamilyId,
+              Unite_Mesure AS unitId,
+              Classification AS classification,
+              Categorie AS category,
+              Poids_Brut AS weight
+         FROM Articles`
+    )
+
+    const map = new Map<number, ArticleInfo>()
+    for (const row of rows) {
+      const id = toNumber(read(row, 'id'))
+      if (id === null) continue
+      map.set(id, {
+        code: clean(read(row, 'code')),
+        name: clean(read(row, 'name')),
+        barcode: clean(read(row, 'barcode')),
+        familyId: toNumber(read(row, 'familyId')),
+        subFamilyId: toNumber(read(row, 'subFamilyId')),
+        unitId: toNumber(read(row, 'unitId')),
+        classification: toNumber(read(row, 'classification')),
+        category: toNumber(read(row, 'category')),
+        weight: toNumber(read(row, 'weight'))
+      })
+    }
+
+    articleCache = { loadedAt: now(), forcedAt: force ? now() : articleCache.forcedAt, map }
+    return map
+  }
+
+  async function getClient(clientId: number | null): Promise<BlClientDto | null> {
+    if (!clientId) return null
+
+    const rows = await db.query(
+      `SELECT IdTiers AS id,
+              Code AS code,
+              Libelle AS name,
+              Proprietaire AS owner,
+              Activite AS activity,
+              Adr_Facturation AS address,
+              Telephone AS phone,
+              Mobile AS mobile,
+              Email AS email,
+              IdentFiscal AS taxId
+         FROM Tiers
+        WHERE IdTiers = ${int(clientId)}`
+    )
+
+    const row = rows[0]
+    if (!row) return null
+    return {
+      id: toNumber(read(row, 'id')),
+      code: clean(read(row, 'code')),
+      name: clean(read(row, 'name')),
+      owner: clean(read(row, 'owner')),
+      activity: clean(read(row, 'activity')),
+      address: clean(read(row, 'address')),
+      phone: clean(read(row, 'phone')),
+      mobile: clean(read(row, 'mobile')),
+      email: clean(read(row, 'email')),
+      taxId: clean(read(row, 'taxId'))
+    }
+  }
+
+  async function getLines(blId: number): Promise<BlLineDto[]> {
+    const rows = await db.query(
+      `SELECT IDLigne_MT AS lineId,
+              IDArticle AS articleId,
+              Libelle AS lineLabel,
+              Qte AS quantity,
+              Nbr_Colis AS packages,
+              Colisage AS packaging,
+              Qte_Vrac AS quantityVrac,
+              Poids AS weight,
+              POIDS_UN AS unitWeight,
+              Ref_Lot AS lot,
+              D_Peremption AS expiryDate,
+              Prix_HT AS unitPriceHt,
+              Resultat_HT AS totalHt
+         FROM Ligne_MT
+        WHERE IDMouvement = ${int(blId)}
+          AND Type = ${int(config.blType)}
+          AND (Sous_Table = 0 OR Sous_Table IS NULL)
+        ORDER BY IDLigne_MT`
+    )
+
+    let articles = await loadArticles()
+    const missing = rows.some((row) => {
+      const id = toNumber(read(row, 'articleId'))
+      return id !== null && !articles.has(id)
+    })
+    if (missing) articles = await loadArticles(true)
+
+    return rows.map((row): BlLineDto => {
+      const articleId = toNumber(read(row, 'articleId'))
+      const article = articleId !== null ? (articles.get(articleId) ?? null) : null
+      const quantity = toNumber(read(row, 'quantity'))
+      const lineWeight = toNumber(read(row, 'weight'))
+      const resolved = resolveLineWeight({
+        quantity,
+        lineWeight,
+        unitWeight: toNumber(read(row, 'unitWeight')),
+        articleWeight: article?.weight ?? null
+      })
+
+      return {
+        lineId: toNumber(read(row, 'lineId')),
+        articleId,
+        code: article?.code ?? null,
+        name: article?.name || clean(read(row, 'lineLabel')),
+        barcode: article?.barcode ?? null,
+        familyId: article?.familyId ?? null,
+        subFamilyId: article?.subFamilyId ?? null,
+        unitId: article?.unitId ?? null,
+        classification: article?.classification ?? null,
+        category: article?.category ?? null,
+        quantity,
+        packages: toNumber(read(row, 'packages')),
+        packaging: toNumber(read(row, 'packaging')),
+        quantityVrac: toNumber(read(row, 'quantityVrac')),
+        weight: lineWeight,
+        weightKg: resolved.weightKg,
+        unitWeightKg: resolved.unitWeightKg,
+        weightSource: resolved.weightSource,
+        lot: clean(read(row, 'lot')),
+        expiryDate: formatDate(read(row, 'expiryDate')),
+        unitPriceHt: toNumber(read(row, 'unitPriceHt')),
+        totalHt: toNumber(read(row, 'totalHt'))
+      }
+    })
+  }
+
+  function findHeaders(parsed: ParsedBlNumber): Promise<Row[]> {
+    const { reference, year, number } = parsed
+    const type = int(config.blType)
+
+    if (reference) {
+      return db.query(
+        `${HEADER_SELECT}
+          WHERE Type = ${type} AND Reference = ${quoteString(reference)}
+          ORDER BY Annee DESC`
+      )
+    }
+
+    if (number === null) return Promise.resolve([])
+
+    if (year !== null) {
+      return db.query(
+        `${HEADER_SELECT}
+          WHERE Type = ${type}
+            AND Annee = ${int(year)}
+            AND Numero = ${int(number)}
+          ORDER BY IDMouvement DESC`
+      )
+    }
+
+    return db.query(
+      `${HEADER_SELECT}
+        WHERE Type = ${type} AND Numero = ${int(number)}
+        ORDER BY Annee DESC`
+    )
+  }
+
+  async function getBl(
+    parsed: ParsedBlNumber,
+    options: GetBlOptions = {}
+  ): Promise<BlResult | BlAmbiguous | null> {
+    const rows = await findHeaders(parsed)
+    if (rows.length === 0) return null
+
+    // Un numéro seul peut exister une fois par année : l'appelant doit préciser.
+    if (!parsed.reference && parsed.year === null && rows.length > 1) {
+      const candidates: BlCandidate[] = []
+      for (const row of rows.slice(0, MAX_CANDIDATES)) {
+        const header = mapHeader(row)
+        let client: BlClientDto | null = null
+        try {
+          client = await getClient(header.clientId)
+        } catch {
+          /* un candidat sans client reste utile */
+        }
+        candidates.push({
+          reference: header.reference,
+          year: header.year,
+          number: header.number,
+          date: header.date,
+          client
+        })
+      }
+      return { ambiguous: true, candidates }
+    }
+
+    const header = mapHeader(rows[0] as Row)
+    if (header.id === null) throw new Error('BL sans identifiant HFSQL.')
+
+    const client = await getClient(header.clientId)
+    const lines = await getLines(header.id)
+
+    const linesTotalHt = round2(lines.reduce((sum, line) => sum + (line.totalHt ?? 0), 0))
+    const totalHt = header.totalHt ? round2(header.totalHt) : linesTotalHt
+    const totalTtc = header.totalTtc ? round2(header.totalTtc) : totalHt
+    const weights = summarizeWeights(lines)
+
+    const full = options.full
+      ? await getFullDetails(schema, config.blType, header.id, header.clientId)
+      : undefined
+
+    return {
+      bl: {
+        id: header.id,
+        reference: header.reference,
+        year: header.year,
+        number: header.number,
+        date: header.date,
+        time: header.time,
+        deliveryDate: header.deliveryDate,
+        status: header.status,
+        client,
+        totalHt,
+        totalTtc,
+        lineCount: lines.length,
+        totalWeightKg: weights.totalWeightKg,
+        knownWeightKg: round3(weights.knownWeightKg),
+        weightComplete: weights.weightComplete,
+        unknownWeightLines: weights.unknownWeightLines
+      },
+      lines,
+      ...(full ? { full } : {})
+    }
+  }
+
+  return { getBl, getClient }
+}
+
+/** Raccourci pour les scripts : texte saisi → BL. */
+export function lookup(service: BlService, raw: string, year?: string, full = false) {
+  return service.getBl(parseBlInput(raw, year), { full })
+}
diff --git a/src/bl-api/cli.ts b/src/bl-api/cli.ts
new file mode 100644
index 0000000..8a661b5
--- /dev/null
+++ b/src/bl-api/cli.ts
@@ -0,0 +1,121 @@
+/**
+ * Outils en ligne de commande pour tester le service contre la vraie base HFSQL.
+ *
+ *   npm run bl:probe [BL26-05255]   vérifie connexion, en-tête, client, lignes, poids
+ *   npm run bl:export [BL26-05255]  écrit samples/ (JSON complet + champs + schéma)
+ *
+ * Lecture seule. samples/ contient des données réelles et est ignoré par git.
+ */
+import 'dotenv/config'
+import { mkdirSync, writeFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { parseBlInput } from '@shared/domain/bl-number'
+import { loadConfig, maskConnectionString } from './config'
+import { createDb } from './db'
+import { createBlService } from './bl-service'
+import { createSchema, type SchemaMap } from './schema'
+import { isAmbiguous } from './types'
+
+const DEFAULT_BL = 'BL26-05255'
+
+function cell(value: unknown): string {
+  if (value === null || value === undefined) return ''
+  return String(value).replace(/\r?\n/g, ' ').slice(0, 180).replace(/\|/g, '\\|')
+}
+
+function section(
+  title: string,
+  row: Record<string, unknown> | null,
+  table: string,
+  tables: SchemaMap
+): string {
+  const byName = new Map((tables[table] ?? []).map((column) => [column.name, column]))
+  const lines = [
+    `## ${title}`,
+    '',
+    '| Champ | Type | Description HFSQL | Valeur |',
+    '| --- | --- | --- | --- |'
+  ]
+  for (const [key, value] of Object.entries(row ?? {})) {
+    const column = byName.get(key)
+    lines.push(`| \`${key}\` | ${column?.type ?? ''} | ${cell(column?.remarks)} | ${cell(value)} |`)
+  }
+  return lines.join('\n')
+}
+
+async function run(): Promise<number> {
+  const [command = 'probe', reference = DEFAULT_BL] = process.argv.slice(2)
+  if (command !== 'probe' && command !== 'export') {
+    console.error('Usage : bl-cli <probe|export> [numéro de BL]')
+    return 2
+  }
+
+  const config = loadConfig()
+  const db = createDb(config)
+  const schema = createSchema(db)
+  const service = createBlService(db, schema, config)
+
+  try {
+    console.log(`Connexion : ${maskConnectionString(config.connectionString)}`)
+    const result = await service.getBl(parseBlInput(reference), { full: command === 'export' })
+
+    if (!result) {
+      console.error(`Aucun BL trouvé pour « ${reference} ».`)
+      return 1
+    }
+    if (isAmbiguous(result)) {
+      console.error(`Numéro ambigu : ${result.candidates.map((c) => c.reference).join(', ')}`)
+      return 1
+    }
+
+    const { bl, lines } = result
+    console.log(`\n${bl.reference} — ${bl.date ?? 'sans date'} — client : ${bl.client?.name ?? '—'}`)
+    for (const line of lines) {
+      console.log(
+        `  ${line.code ?? '?'}  ${line.name ?? ''}  qté ${line.quantity ?? '—'}  → ` +
+          `${line.weightKg ?? 'poids inconnu'} kg (${line.weightSource ?? '—'})`
+      )
+    }
+    console.log(
+      `Poids total : ${bl.totalWeightKg ?? 'incomplet'} kg ` +
+        `(connu ${bl.knownWeightKg} kg, lignes sans poids : ${bl.unknownWeightLines})`
+    )
+
+    if (command === 'export' && result.full) {
+      const out = join(process.cwd(), 'samples')
+      mkdirSync(out, { recursive: true })
+      const tables = await schema.summary()
+      const md = [
+        `# ${bl.reference} — tous les champs disponibles`,
+        '',
+        `${lines.length} ligne(s).`,
+        '',
+        section('En-tête du BL — Mouvement', result.full.header, 'Mouvement', tables),
+        '',
+        section('Client — Tiers', result.full.client, 'Tiers', tables),
+        ''
+      ]
+      result.full.lines.forEach((entry, index) => {
+        md.push(section(`Ligne ${index + 1} — Ligne_MT`, entry.line, 'Ligne_MT', tables), '')
+        if (entry.article) md.push(section('Article', entry.article, 'Articles', tables), '')
+      })
+
+      writeFileSync(join(out, `${bl.reference}-full.json`), `${JSON.stringify(result, null, 2)}\n`)
+      writeFileSync(join(out, 'schema.json'), `${JSON.stringify({ tables }, null, 2)}\n`)
+      writeFileSync(join(out, `${bl.reference}-fields.md`), `${md.join('\n')}\n`)
+      console.log(`\nÉcrit dans ${out}`)
+    }
+    return 0
+  } finally {
+    await db.close()
+  }
+}
+
+run().then(
+  // Sortie explicite : le pilote ODBC peut planter à la fermeture native sous Node 24.
+  (code) => process.exit(code),
+  (error: unknown) => {
+    console.error('ÉCHEC :', error instanceof Error ? error.message : error)
+    process.exit(1)
+  }
+)
