-'use strict';
-
-const db = require('./db');
-const config = require('./config');
-const { getFullDetails } = require('./fullDetails');
-const { resolveLineWeight, summarizeWeights } = require('./weight');
-const { quoteString, int } = require('./sql');
-
-const HEADER_SELECT = `
-  SELECT IDMouvement AS id,
-         Reference AS reference,
-         Annee AS docYear,
-         Numero AS docNumber,
-         Date AS docDate,
-         Heure AS docTime,
-         Date_Livraison AS deliveryDate,
-         Statut AS status,
-         IdTiers AS clientId,
-         HT AS totalHt,
-         TTC AS totalTtc
-    FROM Mouvement`;
-
-const ARTICLE_CACHE_TTL_MS = config.articleCacheTtlMs;
-
-let articleCache = { loadedAt: 0, map: new Map() };
-
-function read(row, key) {
-  if (!row) return undefined;
-  if (key in row) return row[key];
-  const upper = key.toUpperCase();
-  if (upper in row) return row[upper];
-  const lower = key.toLowerCase();
-  if (lower in row) return row[lower];
-  return undefined;
-}
-
-function clean(value) {
-  if (value === null || value === undefined) return null;
-  const text = String(value).trim();
-  return text === '' ? null : text;
-}
-
-function toNumber(value) {
-  if (value === null || value === undefined || value === '') return null;
-  if (typeof value === 'bigint') return Number(value);
-  const number = Number(value);
-  return Number.isFinite(number) ? number : null;
-}
-
-function round2(value) {
-  return Math.round((value + Number.EPSILON) * 100) / 100;
-}
-
-function formatDate(value) {
-  if (value === null || value === undefined || value === '') return null;
-  if (value instanceof Date && !Number.isNaN(value.getTime())) {
-    return value.toISOString().slice(0, 10);
-  }
-  const text = String(value).trim();
-  if (/^\d{8}$/.test(text)) {
-    return `${text.slice(0, 4)}-${text.slice(4, 6)}-${text.slice(6, 8)}`;
-  }
-  if (/^\d{4}-\d{2}-\d{2}/.test(text)) {
-    return text.slice(0, 10);
-  }
-  return null;
-}
-
-function mapHeader(row) {
-  return {
-    id: toNumber(read(row, 'id')),
-    reference: clean(read(row, 'reference')),
-    year: toNumber(read(row, 'docYear')),
-    number: toNumber(read(row, 'docNumber')),
-    date: formatDate(read(row, 'docDate')),
-    time: clean(read(row, 'docTime')),
-    deliveryDate: formatDate(read(row, 'deliveryDate')),
-    status: toNumber(read(row, 'status')),
-    clientId: toNumber(read(row, 'clientId')),
-    totalHt: toNumber(read(row, 'totalHt')),
-    totalTtc: toNumber(read(row, 'totalTtc')),
-  };
-}
-
-async function loadArticles(force = false) {
-  const fresh =
-    !force &&
-    articleCache.map.size > 0 &&
-    Date.now() - articleCache.loadedAt < ARTICLE_CACHE_TTL_MS;
-
-  if (fresh) return articleCache.map;
-
-  const rows = await db.query(
-    `SELECT IDArticle AS id,
-            Reference AS code,
-            Libelle AS name,
-            Code_Barres AS barcode,
-            Famille AS familyId,
-            Sous_Famille AS subFamilyId,
-            Unite_Mesure AS unitId,
-            Classification AS classification,
-            Categorie AS category,
-            Poids_Brut AS weight
-       FROM Articles`
-  );
-
-  const map = new Map();
-  for (const row of rows) {
-    const id = toNumber(read(row, 'id'));
-    if (id === null) continue;
-    map.set(id, {
-      code: clean(read(row, 'code')),
-      name: clean(read(row, 'name')),
-      barcode: clean(read(row, 'barcode')),
-      familyId: toNumber(read(row, 'familyId')),
-      subFamilyId: toNumber(read(row, 'subFamilyId')),
-      unitId: toNumber(read(row, 'unitId')),
-      classification: toNumber(read(row, 'classification')),
-      category: toNumber(read(row, 'category')),
-      weight: toNumber(read(row, 'weight')),
-    });
-  }
-
-  articleCache = { loadedAt: Date.now(), map };
-  return map;
-}
-
-async function getClient(clientId) {
-  if (!clientId) return null;
-
-  const rows = await db.query(
-    `SELECT IdTiers AS id,
-            Code AS code,
-            Libelle AS name,
-            Proprietaire AS owner,
-            Activite AS activity,
-            Adr_Facturation AS address,
-            Telephone AS phone,
-            Mobile AS mobile,
-            Email AS email,
-            IdentFiscal AS taxId
-       FROM Tiers
-      WHERE IdTiers = ${int(clientId)}`
-  );
-
-  if (!rows.length) return null;
-  const row = rows[0];
-  return {
-    id: toNumber(read(row, 'id')),
-    code: clean(read(row, 'code')),
-    name: clean(read(row, 'name')),
-    owner: clean(read(row, 'owner')),
-    activity: clean(read(row, 'activity')),
-    address: clean(read(row, 'address')),
-    phone: clean(read(row, 'phone')),
-    mobile: clean(read(row, 'mobile')),
-    email: clean(read(row, 'email')),
-    taxId: clean(read(row, 'taxId')),
-  };
-}
-
-async function getLines(blId) {
-  const rows = await db.query(
-    `SELECT IDLigne_MT AS lineId,
-            IDArticle AS articleId,
-            Libelle AS lineLabel,
-            Qte AS quantity,
-            Nbr_Colis AS packages,
-            Colisage AS packaging,
-            Qte_Vrac AS quantityVrac,
-            Poids AS weight,
-            POIDS_UN AS unitWeight,
-            Ref_Lot AS lot,
-            D_Peremption AS expiryDate,
-            Prix_HT AS unitPriceHt,
-            Resultat_HT AS totalHt
-       FROM Ligne_MT
-      WHERE IDMouvement = ${int(blId)}
-        AND Type = ${int(config.blType)}
-        AND (Sous_Table = 0 OR Sous_Table IS NULL)
-      ORDER BY IDLigne_MT`
-  );
-
-  let articles = await loadArticles();
-  const needsRefresh = rows.some((row) => {
-    const id = toNumber(read(row, 'articleId'));
-    return id !== null && !articles.has(id);
-  });
-
-  if (needsRefresh) {
-    articles = await loadArticles(true);
-  }
-
-  return rows.map((row) => {
-    const articleId = toNumber(read(row, 'articleId'));
-    const article = articleId !== null ? articles.get(articleId) : null;
-    const lineLabel = clean(read(row, 'lineLabel'));
-    const quantity = toNumber(read(row, 'quantity'));
-    const lineWeight = toNumber(read(row, 'weight'));
-    const unitWeight = toNumber(read(row, 'unitWeight'));
-    const articleWeight = article ? article.weight : null;
-    const resolvedWeight = resolveLineWeight({
-      quantity,
-      lineWeight,
-      unitWeight,
-      articleWeight,
-    });
-
-    return {
-      lineId: toNumber(read(row, 'lineId')),
-      articleId,
-      code: article ? article.code : null,
-      name: (article && article.name) || lineLabel,
-      barcode: article ? article.barcode : null,
-      familyId: article ? article.familyId : null,
-      subFamilyId: article ? article.subFamilyId : null,
-      unitId: article ? article.unitId : null,
-      classification: article ? article.classification : null,
-      category: article ? article.category : null,
-      quantity,
-      packages: toNumber(read(row, 'packages')),
-      packaging: toNumber(read(row, 'packaging')),
-      quantityVrac: toNumber(read(row, 'quantityVrac')),
-      weight: lineWeight,
-      weightKg: resolvedWeight.weightKg,
-      unitWeightKg: resolvedWeight.unitWeightKg,
-      weightSource: resolvedWeight.weightSource,
-      lot: clean(read(row, 'lot')),
-      expiryDate: formatDate(read(row, 'expiryDate')),
-      unitPriceHt: toNumber(read(row, 'unitPriceHt')),
-      totalHt: toNumber(read(row, 'totalHt')),
-    };
-  });
-}
-
-async function findHeaders(parsed) {
-  const { reference, year, number } = parsed;
-  const type = int(config.blType);
-
-  if (reference) {
-    return db.query(
-      `${HEADER_SELECT}
-        WHERE Type = ${type} AND Reference = ${quoteString(reference)}
-        ORDER BY Annee DESC`
-    );
-  }
-
-  if (year !== null) {
-    return db.query(
-      `${HEADER_SELECT}
-        WHERE Type = ${type}
-          AND Annee = ${int(year)}
-          AND Numero = ${int(number)}
-        ORDER BY IDMouvement DESC`
-    );
-  }
-
-  return db.query(
-    `${HEADER_SELECT}
-      WHERE Type = ${type} AND Numero = ${int(number)}
-      ORDER BY Annee DESC`
-  );
-}
-
-async function getBl(parsed, options = {}) {
-  const rows = await findHeaders(parsed);
-
-  if (!rows.length) return null;
-
-  // A bare number can exist once per year. Ask the caller to disambiguate.
-  if (!parsed.reference && parsed.year === null && rows.length > 1) {
-    const candidates = [];
-    for (const row of rows.slice(0, 20)) {
-      const header = mapHeader(row);
-      let client = null;
-      try {
-        client = await getClient(header.clientId);
-      } catch {
-        /* a candidate without a client is still useful */
-      }
-      candidates.push({
-        reference: header.reference,
-        year: header.year,
-        number: header.number,
-        date: header.date,
-        client,
-      });
-    }
-    return { ambiguous: true, candidates };
-  }
-
-  const header = mapHeader(rows[0]);
-  const [client, lines] = await Promise.all([
-    getClient(header.clientId),
-    getLines(header.id),
-  ]);
-
-  const linesTotalHt = round2(
-    lines.reduce((sum, line) => sum + (line.totalHt || 0), 0)
-  );
-  const totalHt =
-    header.totalHt !== null && header.totalHt !== 0
-      ? round2(header.totalHt)
-      : linesTotalHt;
-  const totalTtc =
-    header.totalTtc !== null && header.totalTtc !== 0
-      ? round2(header.totalTtc)
-      : totalHt;
-  const weightSummary = summarizeWeights(lines);
-
-  const full = options.full
-    ? await getFullDetails(header.id, header.clientId)
-    : undefined;
-
-  return {
-    bl: {
-      id: header.id,
-      reference: header.reference,
-      year: header.year,
-      number: header.number,
-      date: header.date,
-      time: header.time,
-      deliveryDate: header.deliveryDate,
-      status: header.status,
-      client,
-      totalHt,
-      totalTtc,
-      lineCount: lines.length,
-      totalWeightKg: weightSummary.totalWeightKg,
-      knownWeightKg: weightSummary.knownWeightKg,
-      weightComplete: weightSummary.weightComplete,
-      unknownWeightLines: weightSummary.unknownWeightLines,
-    },
-    lines,
-    ...(full ? { full } : {}),
-  };
-}
-
-module.exports = { getBl, getClient, loadArticles };
