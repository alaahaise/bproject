-
-  if (table) {
-    if (!schema[table]) {
-      const error = new Error(`Unknown table: ${table}`);
-      error.code = 'UNKNOWN_TABLE';
-      throw error;
-    }
-    return { [table]: schema[table] };
-  }
-
-  return schema;
-}
-
-module.exports = {
-  TABLES,
-  load,
-  selectColumns,
-  selectList,
-  selectAll,
-  summary,
-  quoteIdentifier,
-};
