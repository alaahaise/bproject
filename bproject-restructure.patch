+/**
+ * Contrat service ↔ application : la vraie réponse du service doit être
+ * acceptée par le client Electron (src/main/bl/client.ts). Si l'un des deux
+ * change de forme sans l'autre, ce test casse.
+ */
+import type { AddressInfo } from 'node:net'
+import type { Server } from 'node:http'
+import { afterEach, expect, it } from 'vitest'
+import { lookupBl } from '../main/bl/client'
+import { createBlService } from './bl-service'
+import { createSchema } from './schema'
+import { createApp } from './server'
+import { blHandler, fakeDb } from './fake-db.testutil'
+
+let server: Server | null = null
+
+afterEach(async () => {
+  await new Promise<void>((resolve) => (server ? server.close(() => resolve()) : resolve()))
+  server = null
+})
+
+async function baseUrl(): Promise<string> {
+  const db = fakeDb(blHandler())
+  const schema = createSchema(db)
+  const service = createBlService(db, schema, { blType: 23, articleCacheTtlMs: 60_000 })
+  const app = createApp({
+    config: { corsOrigin: null, publicDir: '/nonexistent' },
+    db,
+    schema,
+    service,
+    log: () => undefined
+  })
+  server = await new Promise<Server>((resolve) => {
+    const s = app.listen(0, '127.0.0.1', () => resolve(s))
+  })
+  return `http://127.0.0.1:${(server.address() as AddressInfo).port}`
+}
+
+it("le client de l'application lit la réponse réelle du service", async () => {
+  const lookup = await lookupBl('BL26-05255', await baseUrl())
+
+  expect(lookup).toMatchObject({
+    reference: 'BL26-05255',
+    date: '2026-07-01',
+    clientName: 'HANGAR AIN NOUISSY',
+    clientCode: '78',
+    totalWeightKg: 2000,
+    weightComplete: true,
+    unknownWeightLines: 0
+  })
+  expect(lookup.lines.map((l) => [l.code, l.weightKg, l.weightSource])).toEqual([
+    ['VIG 1L', 200, 'quintal'],
+    ['INT A+', 600, 'quintal'],
+    ['INT A+', 1200, 'quintal']
+  ])
+})
+
+it('un numéro ambigu remonte les références candidates à l’opérateur', async () => {
+  await expect(lookupBl('5255', await baseUrl())).rejects.toThrow(/BL26-05255, BL25-05255/)
+})
diff --git a/src/bl-api/db.test.ts b/src/bl-api/db.test.ts
new file mode 100644
index 0000000..2302a81
--- /dev/null
+++ b/src/bl-api/db.test.ts
@@ -0,0 +1,149 @@
+import { describe, expect, it } from 'vitest'
+import {
+  createDb,
+  DatabaseUnavailableError,
+  isConnectionError,
+  type OdbcConnection,
+  type OdbcModule,
+  type Row
+} from './db'
+
+const config = { connectionString: 'DSN=test', connectTimeoutMs: 50, queryTimeoutMs: 50 }
+
+function odbcError(message: string, state?: string): Error {
+  return Object.assign(new Error(message), state ? { odbcErrors: [{ state }] } : {})
+}
+
+function fakeOdbc(
+  makeConnection: (index: number) => Partial<OdbcConnection>,
+  failConnect: (index: number) => Error | null = () => null
+) {
+  let connects = 0
+  const closed: number[] = []
+  const odbc: OdbcModule = {
+    async connect() {
+      const index = connects++
+      const failure = failConnect(index)
+      if (failure) throw failure
+      const base = makeConnection(index)
+      return {
+        query: async () => [],
+        columns: async () => [],
+        ...base,
+        close: async () => {
+          closed.push(index)
+        }
+      }
+    }
+  }
+  return { odbc, connects: () => connects, closed }
+}
+
+describe('isConnectionError', () => {
+  it('reconnaît le SQLSTATE de classe 08, quelle que soit la langue', () => {
+    expect(isConnectionError(odbcError('x', '08S01'))).toBe(true)
+    expect(isConnectionError(odbcError('x', '42000'))).toBe(false)
+  })
+
+  it('reconnaît les messages français du pilote', () => {
+    expect(isConnectionError(new Error('Connexion perdue avec le serveur'))).toBe(true)
+    expect(isConnectionError(new Error('Syntax error near FROM'))).toBe(false)
+  })
+})
+
+describe('createDb', () => {
+  it("n'ouvre la connexion qu'à la première requête", async () => {
+    const fake = fakeOdbc(() => ({ query: async () => [{ n: 1 }] as Row[] }))
+    const db = createDb(config, async () => fake.odbc)
+
+    expect(fake.connects()).toBe(0)
+    expect(await db.query('SELECT 1')).toEqual([{ n: 1 }])
+    await db.query('SELECT 2')
+    expect(fake.connects()).toBe(1)
+  })
+
+  it('exécute les requêtes une par une', async () => {
+    let active = 0
+    let maxActive = 0
+    const fake = fakeOdbc(() => ({
+      query: async () => {
+        active += 1
+        maxActive = Math.max(maxActive, active)
+        await new Promise((resolve) => setTimeout(resolve, 5))
+        active -= 1
+        return []
+      }
+    }))
+    const db = createDb(config, async () => fake.odbc)
+
+    await Promise.all([db.query('a'), db.query('b'), db.query('c')])
+    expect(maxActive).toBe(1)
+  })
+
+  it('rouvre une connexion coupée et rejoue la requête', async () => {
+    const fake = fakeOdbc((index) => ({
+      query: async () => {
+        if (index === 0) throw odbcError('Communication link failure', '08S01')
+        return [{ ok: true }] as Row[]
+      }
+    }))
+    const db = createDb(config, async () => fake.odbc)
+
+    expect(await db.query('SELECT 1')).toEqual([{ ok: true }])
+    expect(fake.connects()).toBe(2)
+    expect(fake.closed).toEqual([0])
+  })
+
+  it("déclare la base injoignable si la connexion reste coupée", async () => {
+    const fake = fakeOdbc(() => ({
+      query: async () => {
+        throw odbcError('Connexion perdue', '08S01')
+      }
+    }))
+    const db = createDb(config, async () => fake.odbc)
+
+    await expect(db.query('SELECT 1')).rejects.toBeInstanceOf(DatabaseUnavailableError)
+  })
+
+  it('laisse passer une erreur SQL sans rouvrir la connexion', async () => {
+    const fake = fakeOdbc(() => ({
+      query: async () => {
+        throw odbcError('Syntax error', '42000')
+      }
+    }))
+    const db = createDb(config, async () => fake.odbc)
+
+    await expect(db.query('SELEC')).rejects.toThrow('Syntax error')
+    expect(fake.connects()).toBe(1)
+    expect(fake.closed).toEqual([])
+  })
+
+  it('déclare la base injoignable puis se rétablit quand elle revient', async () => {
+    const fake = fakeOdbc(
+      () => ({ query: async () => [{ n: 1 }] as Row[] }),
+      (index) => (index === 0 ? odbcError('Impossible de se connecter', '08001') : null)
+    )
+    const db = createDb(config, async () => fake.odbc)
+
+    await expect(db.query('SELECT 1')).rejects.toBeInstanceOf(DatabaseUnavailableError)
+    expect(await db.query('SELECT 1')).toEqual([{ n: 1 }])
+  })
+
+  it('ne reste pas bloqué sur une connexion qui ne répond pas', async () => {
+    const odbc: OdbcModule = { connect: () => new Promise(() => undefined) }
+    const db = createDb(config, async () => odbc)
+
+    await expect(db.query('SELECT 1')).rejects.toThrow(/délai/)
+  })
+
+  it('jette une connexion dont la requête dépasse le délai et en rouvre une', async () => {
+    const fake = fakeOdbc((index) => ({
+      query: () => (index === 0 ? new Promise<Row[]>(() => undefined) : Promise.resolve([{ ok: 1 }]))
+    }))
+    const db = createDb(config, async () => fake.odbc)
+
+    await expect(db.query('lent')).rejects.toBeInstanceOf(DatabaseUnavailableError)
+    expect(await db.query('rapide')).toEqual([{ ok: 1 }])
+    expect(fake.connects()).toBe(2)
+  })
+})
diff --git a/src/bl-api/db.ts b/src/bl-api/db.ts
new file mode 100644
index 0000000..94e3cd6
--- /dev/null
+++ b/src/bl-api/db.ts
@@ -0,0 +1,172 @@
+/**
+ * Accès ODBC à HFSQL : une connexion partagée, des requêtes sérialisées.
+ *
+ * Choix de conception :
+ * - la connexion est ouverte à la demande, pas au démarrage : le service doit
+ *   pouvoir démarrer (et le dire) quand HFSQL est injoignable, par exemple en
+ *   télétravail, puis se rétablir seul quand la base revient ;
+ * - les délais sont appliqués ici, en JavaScript, plutôt que par les options
+ *   ODBC : tous les pilotes ne les supportent pas, celui de HFSQL est inconnu ;
+ * - une requête qui dépasse son délai fait jeter la connexion (la suivante en
+ *   rouvre une) pour qu'une requête bloquée ne gèle pas toutes les autres ;
+ * - une connexion coupée est rouverte une fois, sans risque : le service ne
+ *   fait que des SELECT.
+ */
+import type { BlApiConfig } from './config'
+
+export type Row = Record<string, unknown>
+
+/** Sous-ensemble de `odbc` utilisé ici (permet de le remplacer dans les tests). */
+export interface OdbcConnection {
+  query(sql: string): Promise<ArrayLike<Row>>
+  columns(catalog: null, schema: null, table: string, column: null): Promise<ArrayLike<Row>>
+  close(): Promise<void>
+}
+export interface OdbcModule {
+  connect(connectionString: string): Promise<OdbcConnection>
+}
+
+export interface Db {
+  query(sql: string): Promise<Row[]>
+  columns(table: string): Promise<Row[]>
+  close(): Promise<void>
+}
+
+/** HFSQL est injoignable (réseau, serveur arrêté, délai dépassé). */
+export class DatabaseUnavailableError extends Error {
+  readonly code = 'DATABASE_UNAVAILABLE'
+
+  constructor(message: string, options?: { cause?: unknown }) {
+    super(message, options)
+    this.name = 'DatabaseUnavailableError'
+  }
+}
+
+class TimeoutError extends Error {}
+
+const CONNECTION_MESSAGE =
+  /connection|communication|link|socket|network|not connected|closed|eof|connexion|perdue|r[ée]seau/i
+
+function describe(error: unknown): string {
+  return String((error as { message?: unknown } | null)?.message ?? error ?? '')
+}
+
+/**
+ * Erreur de connexion plutôt que de SQL ? On regarde d'abord le SQLSTATE
+ * (classe 08 = problème de connexion), indépendant de la langue du pilote, puis
+ * le texte (le pilote HFSQL répond en français).
+ */
+export function isConnectionError(error: unknown): boolean {
+  const states = (error as { odbcErrors?: Array<{ state?: unknown }> } | null)?.odbcErrors
+  if (Array.isArray(states) && states.some((entry) => String(entry?.state ?? '').startsWith('08'))) {
+    return true
+  }
+  return CONNECTION_MESSAGE.test(describe(error))
+}
+
+function withTimeout<T>(work: Promise<T>, ms: number, label: string): Promise<T> {
+  let timer: NodeJS.Timeout | undefined
+  const timeout = new Promise<never>((_, reject) => {
+    timer = setTimeout(() => reject(new TimeoutError(`${label} : délai de ${ms} ms dépassé`)), ms)
+  })
+  return Promise.race([work, timeout]).finally(() => clearTimeout(timer))
+}
+
+/** `odbc` est un module CommonJS natif : selon le chargeur, `connect` est sur `default` ou sur le module. */
+async function loadNativeOdbc(): Promise<OdbcModule> {
+  const loaded = (await import('odbc')) as unknown as Partial<OdbcModule> & { default?: OdbcModule }
+  return (loaded.default ?? loaded) as OdbcModule
+}
+
+type DbConfig = Pick<BlApiConfig, 'connectionString' | 'connectTimeoutMs' | 'queryTimeoutMs'>
+
+export function createDb(
+  config: DbConfig,
+  loadOdbc: () => Promise<OdbcModule> = loadNativeOdbc
+): Db {
+  let connection: OdbcConnection | null = null
+  let opening: Promise<OdbcConnection> | null = null
+  let queue: Promise<unknown> = Promise.resolve()
+
+  async function open(): Promise<OdbcConnection> {
+    if (connection) return connection
+    opening ??= (async () => {
+      try {
+        const odbc = await loadOdbc()
+        const opened = await withTimeout(
+          odbc.connect(config.connectionString),
+          config.connectTimeoutMs,
+          'Connexion HFSQL'
+        )
+        connection = opened
+        return opened
+      } catch (error) {
+        throw new DatabaseUnavailableError(`HFSQL injoignable : ${describe(error)}`, {
+          cause: error
+        })
+      } finally {
+        opening = null
+      }
+    })()
+    return opening
+  }
+
+  async function discard(broken: OdbcConnection): Promise<void> {
+    if (connection === broken) connection = null
+    try {
+      await broken.close()
+    } catch {
+      /* déjà fermée ou bloquée : rien à faire */
+    }
+  }
+
+  async function run<T>(label: string, work: (c: OdbcConnection) => Promise<T>): Promise<T> {
+    for (let attempt = 0; ; attempt += 1) {
+      const current = await open()
+      try {
+        return await withTimeout(work(current), config.queryTimeoutMs, label)
+      } catch (error) {
+        if (error instanceof TimeoutError) {
+          // On ne rejoue pas : on a déjà attendu le délai complet.
+          void discard(current)
+          throw new DatabaseUnavailableError(`HFSQL ne répond pas : ${error.message}`, {
+            cause: error
+          })
+        }
+        if (!isConnectionError(error)) throw error
+        await discard(current)
+        if (attempt >= 1) {
+          throw new DatabaseUnavailableError(`Connexion HFSQL perdue : ${describe(error)}`, {
+            cause: error
+          })
+        }
+      }
+    }
+  }
+
+  /** Une seule requête à la fois sur la connexion partagée. */
+  function enqueue<T>(task: () => Promise<T>): Promise<T> {
+    const result = queue.then(task)
+    queue = result.catch(() => undefined)
+    return result
+  }
+
+  return {
+    query: (sql) => enqueue(async () => Array.from(await run('Requête', (c) => c.query(sql)))),
+    columns: (table) =>
+      enqueue(async () =>
+        Array.from(await run(`Colonnes de ${table}`, (c) => c.columns(null, null, table, null)))
+      ),
+    close: async () => {
+      const current = connection
+      connection = null
+      if (current) {
+        try {
+          await current.close()
+        } catch {
+          /* ignoré à l'arrêt */
+        }
+      }
+    }
+  }
+}
diff --git a/src/bl-api/fake-db.testutil.ts b/src/bl-api/fake-db.testutil.ts
new file mode 100644
index 0000000..ba1694a
--- /dev/null
+++ b/src/bl-api/fake-db.testutil.ts
@@ -0,0 +1,78 @@
+/**
+ * Fausse base pour les tests : répond aux requêtes du service d'après des
+ * fragments de SQL. Elle vérifie la logique (mapping, poids, ambiguïté,
+ * cache), PAS la validité du SQL côté HFSQL : pour cela, `npm run bl:probe`.
+ */
+import type { Db, Row } from './db'
+
+export type Handler = (sql: string) => Row[] | undefined
+
+export function fakeDb(handler: Handler): Db & { queries: string[] } {
+  const queries: string[] = []
+  return {
+    queries,
+    async query(sql) {
+      queries.push(sql)
+      const rows = handler(sql)
+      if (!rows) throw new Error(`fake db: requête inattendue : ${sql.slice(0, 80)}`)
+      return rows
+    },
+    async columns() {
+      return []
+    },
+    async close() {}
+  }
+}
+
+const header = (id: number, reference: string, year: number, clientId = 105): Row => ({
+  id,
+  reference,
+  docYear: year,
+  docNumber: 5255,
+  docDate: `${year}0701`,
+  docTime: '10:34:00.000',
+  deliveryDate: `${year}0701`,
+  status: 1,
+  clientId,
+  totalHt: 89200,
+  totalTtc: 89200
+})
+
+export const ARTICLES: Row[] = [
+  { id: 230, code: 'VIG 1L', name: 'Vigosine 1L', weight: 0 },
+  { id: 231, code: 'INT A+', name: 'Introvit A+', weight: 0 }
+]
+
+const line = (lineId: number, articleId: number, quantity: number): Row => ({
+  lineId,
+  articleId,
+  quantity,
+  weight: 0,
+  unitWeight: 0,
+  totalHt: 1
+})
+
+/** BL26-05255 (3 lignes, 2 + 6 + 12 quintaux) et BL25-05255 (même numéro, 2025). */
+export function blHandler(overrides: { lines?: Row[]; articles?: Row[] } = {}): Handler {
+  return (sql) => {
+    if (/COUNT\(\*\)/.test(sql)) return [{ n: 37856 }]
+    if (/FROM Mouvement/.test(sql)) {
+      if (/Reference = 'BL26-05255'/.test(sql) || /Annee = 2026/.test(sql)) {
+        return [header(39394, 'BL26-05255', 2026)]
+      }
+      if (/Annee = 2025/.test(sql)) return [header(30001, 'BL25-05255', 2025)]
+      if (/Numero = 5255/.test(sql)) {
+        return [header(39394, 'BL26-05255', 2026), header(30001, 'BL25-05255', 2025)]
+      }
+      return []
+    }
+    if (/FROM Tiers/.test(sql)) {
+      return [{ id: 105, code: '78', name: 'HANGAR AIN NOUISSY', owner: 'SID AHMED MANSOUR' }]
+    }
+    if (/FROM Articles/.test(sql)) return overrides.articles ?? ARTICLES
+    if (/FROM Ligne_MT/.test(sql)) {
+      return overrides.lines ?? [line(1, 230, 2), line(2, 231, 6), line(3, 231, 12)]
+    }
+    return undefined
+  }
+}
diff --git a/src/bl-api/full-details.ts b/src/bl-api/full-details.ts
new file mode 100644
index 0000000..7f206f5
--- /dev/null
+++ b/src/bl-api/full-details.ts
@@ -0,0 +1,162 @@
+/**
+ * Dump complet et non vide de chaque colonne autour d'un BL (`?full=1`).
+ *
+ * `SELECT *` est inutilisable sur Articles avec ce pilote : toutes les requêtes
+ * passent par une liste de colonnes explicite, colonnes binaires exclues. Les
+ * valeurs vides sont omises ; `/api/schema` liste toutes les colonnes.
+ */
+import type { Row } from './db'
+import type { ColumnInfo, Schema } from './schema'
+import { int } from './sql'
+
+const DATE_TYPES = new Set(['SQL_DATE', 'SQL_TYPE_DATE'])
+const TIMESTAMP_TYPES = new Set(['SQL_TIMESTAMP', 'SQL_TYPE_TIMESTAMP'])
+
+export interface FullLine {
+  line: Record<string, unknown>
+  article: Record<string, unknown> | null
+}
+
+export interface FullDetails {
+  header: Record<string, unknown> | null
+  client: Record<string, unknown> | null
+  lines: FullLine[]
+}
+
+function normalizeKey(key: string): string {
+  return key
+    .normalize('NFD')
+    .replace(/[\u0300-\u036f]/g, '')
+    .replace(/[^A-Z0-9]/gi, '')
+    .toUpperCase()
+}
+
+/** Le pilote peut renvoyer la casse ou l'accentuation autrement que le schéma. */
+export function readColumn(row: Row | undefined, name: string): unknown {
+  if (!row) return undefined
+  const has = (key: string): boolean => Object.prototype.hasOwnProperty.call(row, key)
+  if (has(name)) return row[name]
+  if (has(name.toUpperCase())) return row[name.toUpperCase()]
+  if (has(name.toLowerCase())) return row[name.toLowerCase()]
+
+  const wanted = normalizeKey(name)
+  for (const key of Object.keys(row)) {
+    if (normalizeKey(key) === wanted) return row[key]
+  }
+  return undefined
+}
+
+function toNumber(value: unknown): number | string | null {
+  if (value === null || value === undefined || value === '') return null
+  if (typeof value === 'bigint') {
+    return value <= BigInt(Number.MAX_SAFE_INTEGER) && value >= BigInt(Number.MIN_SAFE_INTEGER)
+      ? Number(value)
+      : value.toString()
+  }
+  const number = Number(value)
+  return Number.isFinite(number) ? number : null
+}
+
+function formatDateText(text: string): string {
+  return /^\d{8}$/.test(text) ? `${text.slice(0, 4)}-${text.slice(4, 6)}-${text.slice(6, 8)}` : text
+}
+
+function formatTimestampText(text: string): string {
+  return /^\d{14}$/.test(text)
+    ? `${text.slice(0, 4)}-${text.slice(4, 6)}-${text.slice(6, 8)}` +
+        `T${text.slice(8, 10)}:${text.slice(10, 12)}:${text.slice(12, 14)}`
+    : text
+}
+
+export function normalizeValue(value: unknown, column: ColumnInfo): unknown {
+  if (value === null || value === undefined) return null
+  if (typeof value === 'bigint') return toNumber(value)
+  if (value instanceof Date) return Number.isNaN(value.getTime()) ? null : value.toISOString()
+
+  // Champs binaires : inutiles en JSON, déjà exclus du SELECT.
+  if (typeof value === 'object') return null
+
+  if (typeof value === 'string') {
+    const text = value.trim()
+    if (text === '') return null
+    // HFSQL renvoie parfois \x04 pour une date vide ou invalide.
+    // eslint-disable-next-line no-control-regex
+    if (/^[\x00-\x08\x0B\x0C\x0E-\x1F]+$/.test(text)) return null
+    if (DATE_TYPES.has(column.type)) return formatDateText(text)
+    if (TIMESTAMP_TYPES.has(column.type)) return formatTimestampText(text)
+    return text
+  }
+
+  if (typeof value === 'number') return Number.isFinite(value) ? value : null
+  return value
+}
+
+function rowToObject(row: Row, columns: ColumnInfo[]): Record<string, unknown> {
+  const result: Record<string, unknown> = {}
+  for (const column of columns) {
+    const value = normalizeValue(readColumn(row, column.name), column)
+    if (value !== null) result[column.name] = value
+  }
+  return result
+}
+
+export async function getFullDetails(
+  schema: Schema,
+  blType: number,
+  blId: number,
+  clientId: number | null
+): Promise<FullDetails> {
+  const [headerColumns, clientColumns, lineColumns] = await Promise.all([
+    schema.selectColumns('Mouvement'),
+    schema.selectColumns('Tiers'),
+    schema.selectColumns('Ligne_MT')
+  ])
+
+  const [headerRows, clientRows, lineRows] = await Promise.all([
+    schema.selectAll('Mouvement', `IDMOUVEMENT = ${int(blId)}`),
+    clientId === null ? Promise.resolve([]) : schema.selectAll('Tiers', `IDTIERS = ${int(clientId)}`),
+    schema.selectAll(
+      'Ligne_MT',
+      `IDMOUVEMENT = ${int(blId)}
+       AND TYPE = ${int(blType)}
+       AND (SOUS_TABLE = 0 OR SOUS_TABLE IS NULL)`,
+      'IDLIGNE_MT'
+    )
+  ])
+
+  const articleIds = [
+    ...new Set(
+      lineRows
+        .map((row) => toNumber(readColumn(row, 'IDARTICLE')))
+        .filter((id): id is number => typeof id === 'number' && Number.isSafeInteger(id) && id > 0)
+    )
+  ]
+
+  let articleColumns: ColumnInfo[] = []
+  let articleRows: Row[] = []
+  if (articleIds.length > 0) {
+    articleColumns = await schema.selectColumns('Articles')
+    articleRows = await schema.selectAll(
+      'Articles',
+      `IDARTICLE IN (${articleIds.map((id) => int(id)).join(', ')})`
+    )
+  }
+
+  const articlesById = new Map<number, Record<string, unknown>>()
+  for (const row of articleRows) {
+    const id = toNumber(readColumn(row, 'IDARTICLE'))
+    if (typeof id === 'number') articlesById.set(id, rowToObject(row, articleColumns))
+  }
+
+  return {
+    header: headerRows[0] ? rowToObject(headerRows[0], headerColumns) : null,
+    client: clientRows[0] ? rowToObject(clientRows[0], clientColumns) : null,
+    lines: lineRows.map((row) => {
+      const articleId = toNumber(readColumn(row, 'IDARTICLE'))
+      return {
+        line: rowToObject(row, lineColumns),
+        article: typeof articleId === 'number' ? (articlesById.get(articleId) ?? null) : null
+      }
+    })
+  }
+}
