{
  "name": "caspm-bl-api",
  "version": "1.0.0",
  "description": "Read-only API that returns the client and products of an HFSQL BL (bon de livraison)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "probe": "node scripts/probe.js",
    "export": "node scripts/export-full.js",
    "test": "node --test \"test/*.test.js\""
  },
  "keywords": [
    "hfsql",
    "odbc",
    "bl",
    "caspm"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "express": "^5.1.0",
    "odbc": "^2.6.0"
  },
  "allowScripts": {
    "odbc@2.6.0": true
  }
}
