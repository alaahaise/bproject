--- /dev/null
+++ b/src/shared/domain/vrac.test.ts
@@ -0,0 +1,84 @@
+import { describe, expect, it } from 'vitest'
+import { BL_MATCH_TOLERANCE_KG, buildVracLine, canBeVrac, compareBlToNet, isBlPending } from './vrac'
+
+describe('canBeVrac', () => {
+  it('seule une sortie ordinaire peut être du vrac', () => {
+    expect(canBeVrac('SORTIE', false)).toBe(true)
+    expect(canBeVrac('SORTIE', true)).toBe(false)
+    expect(canBeVrac('ENTREE', false)).toBe(false)
+    expect(canBeVrac('TRANSFERT', false)).toBe(false)
+    expect(canBeVrac('TIERS', false)).toBe(false)
+  })
+})
+
+describe('buildVracLine', () => {
+  it('prend le poids net pour quantité', () => {
+    expect(buildVracLine('Maïs vrac', 28350)).toEqual({
+      ok: true,
+      line: { productCode: 'Maïs vrac', quantityKg: 28350 }
+    })
+  })
+
+  it('nettoie le produit et arrondit au gramme', () => {
+    expect(buildVracLine('  Son  ', 1000.00049)).toEqual({
+      ok: true,
+      line: { productCode: 'Son', quantityKg: 1000 }
+    })
+  })
+
+  it('refuse sans produit', () => {
+    expect(buildVracLine('', 100)).toEqual({ ok: false, reason: 'NO_PRODUCT' })
+    expect(buildVracLine('   ', 100)).toEqual({ ok: false, reason: 'NO_PRODUCT' })
+    expect(buildVracLine(null, 100)).toEqual({ ok: false, reason: 'NO_PRODUCT' })
+  })
+
+  it('refuse un net nul : pas de quantité, donc pas de stock ni de BL possible', () => {
+    expect(buildVracLine('Maïs', 0)).toEqual({ ok: false, reason: 'NET_NOT_POSITIVE' })
+  })
+
+  it('coupe un nom trop long à la taille de la colonne', () => {
+    const result = buildVracLine('x'.repeat(100), 10)
+    expect(result.ok && result.line.productCode).toHaveLength(64)
+  })
+})
+
+describe('isBlPending', () => {
+  const base = { isVrac: true, blNo: null, status: 'FERMEE', second: { weight: 1 } }
+
+  it('un vrac pesé sans BL attend son BL', () => {
+    expect(isBlPending(base)).toBe(true)
+    expect(isBlPending({ ...base, blNo: '  ' })).toBe(true)
+  })
+
+  it("n'attend plus rien une fois le BL renseigné", () => {
+    expect(isBlPending({ ...base, blNo: 'BL26-05255' })).toBe(false)
+  })
+
+  it("n'attend pas de BL avant la 2e pesée, ni annulé, ni hors vrac", () => {
+    expect(isBlPending({ ...base, second: null })).toBe(false)
+    expect(isBlPending({ ...base, status: 'ANNULEE' })).toBe(false)
+    expect(isBlPending({ ...base, isVrac: false })).toBe(false)
+  })
+})
+
+describe('compareBlToNet', () => {
+  it('concorde à la tolérance près (arrondi au quintal)', () => {
+    expect(compareBlToNet(28350.4, 28350)).toMatchObject({ kind: 'match', diffKg: 0.4 })
+    expect(compareBlToNet(2000, 2000 + BL_MATCH_TOLERANCE_KG)).toMatchObject({ kind: 'match' })
+  })
+
+  it('signale un BL qui facture plus ou moins que la pesée', () => {
+    expect(compareBlToNet(30000, 28350)).toEqual({
+      kind: 'differs',
+      blWeightKg: 30000,
+      netKg: 28350,
+      diffKg: 1650
+    })
+    expect(compareBlToNet(28000, 28350)).toMatchObject({ kind: 'differs', diffKg: -350 })
+  })
+
+  it('ne juge pas quand un poids manque (BL sans poids connu)', () => {
+    expect(compareBlToNet(null, 28350)).toEqual({ kind: 'unknown' })
+    expect(compareBlToNet(28350, null)).toEqual({ kind: 'unknown' })
+  })
+})
diff --git a/src/shared/domain/vrac.ts b/src/shared/domain/vrac.ts
new file mode 100644
index 0000000..e630e57
--- /dev/null
+++ b/src/shared/domain/vrac.ts
@@ -0,0 +1,69 @@
+/**
+ * Règles du vrac : une sortie pesée avant qu'aucun BL n'existe.
+ *
+ * Fonctions pures (ni Electron ni MySQL) : le dépôt les applique, l'écran les
+ * utilise pour décider quoi afficher.
+ */
+import type { OperationType, ProductLine } from '../types'
+import { roundKg } from './weighing'
+
+/** Seule une vraie sortie peut être du vrac : ni entrée, ni transfert, ni retour. */
+export function canBeVrac(type: OperationType, isRetour: boolean): boolean {
+  return type === 'SORTIE' && !isRetour
+}
+
+export type VracLineResult =
+  | { ok: true; line: ProductLine }
+  | { ok: false; reason: 'NO_PRODUCT' | 'NET_NOT_POSITIVE' }
+
+/**
+ * La ligne unique d'un ticket vrac : le produit saisi, et le poids net pesé
+ * pour quantité. Un seul produit : le net ne peut pas se répartir entre
+ * plusieurs produits sans BL pour dire combien de chacun.
+ */
+export function buildVracLine(
+  productCode: string | null | undefined,
+  netWeight: number
+): VracLineResult {
+  const product = productCode?.trim() ?? ''
+  if (product === '') return { ok: false, reason: 'NO_PRODUCT' }
+  const net = roundKg(netWeight)
+  if (!(net > 0)) return { ok: false, reason: 'NET_NOT_POSITIVE' }
+  return { ok: true, line: { productCode: product.slice(0, 64), quantityKg: net } }
+}
+
+/**
+ * Un vrac pesé attend son BL tant que le commercial ne l'a pas établi. Même
+ * définition que le filtre SQL `blPending`.
+ */
+export function isBlPending(op: {
+  isVrac: boolean
+  blNo?: string | null
+  status: string
+  second: unknown
+}): boolean {
+  return op.isVrac && op.second != null && op.status !== 'ANNULEE' && !op.blNo?.trim()
+}
+
+/** Au-delà, le BL du commercial ne correspond plus au poids pesé (arrondi au quintal près). */
+export const BL_MATCH_TOLERANCE_KG = 1
+
+export type BlCheck =
+  | { kind: 'unknown' }
+  | { kind: 'match' | 'differs'; blWeightKg: number; netKg: number; diffKg: number }
+
+/**
+ * Compare le poids du BL établi par le commercial au poids net pesé. `diffKg`
+ * = BL − pesée : positif quand le BL facture plus que ce qui est sorti.
+ * Informatif : l'écran signale la différence, il ne bloque pas.
+ */
+export function compareBlToNet(blWeightKg: number | null, netKg: number | null): BlCheck {
+  if (blWeightKg == null || netKg == null) return { kind: 'unknown' }
+  const diffKg = roundKg(blWeightKg - netKg)
+  return {
+    kind: Math.abs(diffKg) <= BL_MATCH_TOLERANCE_KG ? 'match' : 'differs',
+    blWeightKg: roundKg(blWeightKg),
+    netKg: roundKg(netKg),
+    diffKg
+  }
+}
